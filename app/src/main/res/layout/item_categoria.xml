<?xml version="1.0" encoding="utf-8"?>
<!--
    Item do RecyclerView "recyclerViewCategorias" (activity_monthly_statement.xml).
    Alimentado por um GROUP BY produtos.categoria a partir de itens_pedido / itens_venda_balcao
    filtrando pelo id_aluno e mês de referência.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_icon_circle_purple">

        <ImageView
            android:id="@+id/ivIconeCategoria"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_receipt"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNomeCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lanches"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQtdItensCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="21 itens"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvValorCategoria"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="R$ 214,30"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
