<?xml version="1.0" encoding="utf-8"?>
<!--
    Item usado no RecyclerView rv_produtos (activity_cardapio_gerenciar.xml).
    Vem direto da tabela produtos:
      - tv_nome_produto        -> produtos.nome
      - tv_status_disponibilidade -> "Disponível" (esgotado=false) ou "Esgotado" (esgotado=true)
      - tv_preco_produto       -> produtos.preco formatado em R$
      - tv_badge_status        -> "ATIVO" / "ESGOTADO"
    O root inteiro é clicável e deve abrir EditarLancheActivity passando produtos.id.
    No adapter, trocar o background do root para @drawable/bg_item_produto_esgotado
    quando produtos.esgotado == true.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_item_produto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_card_rounded"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_nome_produto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sanduíche natural"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_status_disponibilidade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Disponível • toque para editar"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tv_preco_produto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R$ 12,00"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_badge_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_badge_green"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="ATIVO"
            android:textColor="@color/green_success_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
