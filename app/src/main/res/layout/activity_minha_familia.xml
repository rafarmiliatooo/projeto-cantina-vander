<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Minha família"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Responsável • Renato"
        android:textSize="12sp"
        android:textColor="#6B7280"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Card Alerta Consolidado -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardConsolidado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="#F3E8FF"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitulo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consolidado de agosto disponível"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#6B4283" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Hoje é dia 1º. Confira a conta do mês anterior e realize o pagamento."
                android:textSize="12sp"
                android:textColor="#4B5563" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Seção Seus Filhos -->
    <TextView
        android:id="@+id/tvSeusFilhos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Seus filhos"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#1F2937"
        app:layout_constraintTop_toBottomOf="@id/cardConsolidado"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Card Lucas Mendes -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLucas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/tvSeusFilhos">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lucas Mendes"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6º ano B • Saldo R$ 24,50"
                android:textSize="12sp"
                android:textColor="#6B7280" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Card Júlia Mendes -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardJulia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/cardLucas">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Júlia Mendes"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8º ano A • Saldo baixo R$ 9,10"
                android:textSize="12sp"
                android:textColor="#DC2626" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Botão Cadastrar/Vincular Filho -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCadastrarFilho"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="+ Cadastrar / Vincular filho"
        android:textColor="#6B4283"
        app:strokeColor="#6B4283"
        app:cornerRadius="24dp"
        app:layout_constraintTop_toBottomOf="@id/cardJulia" />

</androidx.constraintlayout.widget.ConstraintLayout>