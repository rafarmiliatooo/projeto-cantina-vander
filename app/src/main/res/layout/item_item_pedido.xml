<?xml version="1.0" encoding="utf-8"?>
<!--
    Item usado no RecyclerView rv_itens_pedido (activity_detalhe_pedido.xml).
    Vem de itens_pedido JOIN produtos:
      - tv_qtd_produto      -> itens_pedido.quantidade + produtos.nome ("1x Sanduíche natural")
      - tv_obs_item         -> observação livre (ex: "Sem alterações" / "Restrição: sem açúcar")
      - tv_preco_item       -> itens_pedido.preco_unitario * quantidade formatado em R$
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/ic_receipt"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_qtd_produto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1× Sanduíche natural"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_obs_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Sem alterações"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_preco_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="R$ 12,00"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
