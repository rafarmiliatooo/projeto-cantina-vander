<?xml version="1.0" encoding="utf-8"?>
<!--
  Activity Java correspondente: RevisarPedidoActivity.java
  IDs a vincular:
    btnVoltarRevisar    -> finish() (volta para personalizar)
    tvHorarioRevisar    -> pedidos.intervalo escolhido
    tvAlergiaRevisar    -> pedidos.alergia (some/oculta se vazio)
    rvItensRevisar      -> RecyclerView com itens_pedido (item_pedido_resumo.xml)
    tvSubtotalRevisar   -> soma dos itens
    tvTotalRevisar      -> valor final = pedidos.valor_total
    btnConfirmarPedido  -> INSERT em pedidos + itens_pedido, gera codigo_retirada
                           e abre PedidoConfirmadoActivity
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Topbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnVoltarRevisar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Voltar"
            android:src="@android:drawable/ic_menu_revert"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/titulo_revisar"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Info do horário / alergia -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Horário de retirada"
                        android:textColor="@color/text_gray"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tvHorarioRevisar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="09:00"
                        android:textColor="@color/text_dark"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAlergiaRevisar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="⚠ Alergia a amendoim"
                    android:textColor="@color/orange_alert"
                    android:textSize="13sp"
                    tools:visibility="visible"/>
            </LinearLayout>

            <!-- Itens -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Itens"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvItensRevisar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_pedido_resumo"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="@color/divider"/>

            <!-- Subtotal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/subtotal_label"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvSubtotalRevisar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$ 70,50"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Rodapé com total e confirmar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_bg"
        android:padding="16dp"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/total_label"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvTotalRevisar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 70,50"
                android:textColor="@color/green_primary_dark"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnConfirmarPedido"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_green"
            android:text="@string/btn_confirmar_pedido"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
