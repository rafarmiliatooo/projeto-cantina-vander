<?xml version="1.0" encoding="utf-8"?>
<!--
    Item do RecyclerView "recyclerViewAvisosHoje" (activity_notifications_center.xml).
    Tipos de aviso (usados para trocar cor/ícone no Adapter via tvTipoAviso/getTag):
        SALDO_BAIXO  -> saldo abaixo de limite_diario/aviso configurado (cartão amarelo)
        LIMITE       -> % do limite_fiado já utilizado (cartão laranja)
        CONTA        -> consolidado mensal disponível para pagamento (cartão roxo)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootItemAvisoHoje"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_yellow"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_icon_circle_yellow">

        <ImageView
            android:id="@+id/ivIconeAvisoHoje"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_warning"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTituloAvisoHoje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saldo baixo • Júlia"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDescricaoAvisoHoje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="O saldo chegou a R$ 9,20, abaixo do aviso de R$ 15,00."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
