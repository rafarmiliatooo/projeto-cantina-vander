<?xml version="1.0" encoding="utf-8"?>
<!--
    Item usado no RecyclerView rv_pedidos_antecipados (activity_painel_cozinha.xml).
    Campos vêm do JOIN entre pedidos + usuarios (id_aluno):
      - tv_nome_aluno      -> usuarios.nome
      - tv_codigo_pedido   -> pedidos.codigo_retirada
      - tv_turma_aluno     -> usuarios.turma
      - tv_produto_resumo  -> nomes dos itens (itens_pedido -> produtos.nome), concatenados
      - tv_status_pedido   -> pedidos.status ("pendente" / "em_preparacao" / "entregue")
    O clique no item inteiro (root) deve abrir DetalhePedidoActivity passando pedidos.id.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_item_pedido"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tv_avatar_iniciais"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_avatar_circle"
        android:gravity="center"
        android:text="LM"
        android:textColor="@color/teal_700"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_nome_aluno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lucas Mendes"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_turma_aluno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="8ºB"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_produto_resumo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Sanduíche natural + suco"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tv_codigo_pedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A184"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_status_pedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_badge_orange"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Preparando"
            android:textColor="@color/orange_warning_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
