<?xml version="1.0" encoding="UTF-8"?>

    <resources>


    -<style name="ChipBase">

    <item name="android:layout_width">wrap_content</item>

    <item name="android:layout_height">36dp</item>

    <item name="android:layout_marginEnd">8dp</item>

    <item name="android:gravity">center</item>

    <item name="android:paddingHorizontal">18dp</item>

    <item name="android:textSize">13sp</item>

    <item name="android:textStyle">bold</item>

    <item name="android:clickable">true</item>

    <item name="android:focusable">true</item>

</style>


    -<style name="ChipSelecionado" parent="ChipBase">

    <item name="android:background">@drawable/bg_chip_selected</item>

    <item name="android:textColor">@color/white</item>

</style>


    -<style name="ChipNaoSelecionado" parent="ChipBase">

    <item name="android:background">@drawable/bg_chip_unselected</item>

    <item name="android:textColor">@color/text_gray</item>

</style>

</resources>